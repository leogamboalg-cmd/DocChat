{
  "manifest_version": 3,
  "name": "DocChat",
  "version": "0.1.0",
  "description": "Ask questions about the Google Doc you are viewing.",
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/d/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
